# Copy to .env and change the passwords. docker compose and npm read it.

# MySQL, as the API reaches it. Locally the container is published on 3307
# (3306 is often taken); inside compose the API uses db:3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=guerra_naval
DB_USER=guerra_naval
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# API
PORT=3000
HOST=127.0.0.1

# Published ports of the deployment.
DB_PUBLISHED_PORT=3307
WEB_PUBLISHED_PORT=8080
