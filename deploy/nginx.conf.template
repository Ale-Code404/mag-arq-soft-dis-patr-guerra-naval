# One origin for the page and the API, as the Vite proxy does in development,
# so the session cookie (SameSite=Lax) travels with every call. The official
# image fills ${PORT} and ${API_UPSTREAM} from the environment on start:
# api:3000 in compose, api.railway.internal:3000 on Railway.
map $http_x_real_ip $edge_ip {
  "" $remote_addr;
  default $http_x_real_ip;
}

map $http_cf_connecting_ip $client_ip {
  "" $edge_ip;
  default $http_cf_connecting_ip;
}

map "$request_method $uri" $auth_key {
  "~^POST /api/(players|session)$" $client_ip;
  default "";
}

limit_req_zone $client_ip zone=api:10m rate=20r/s;
limit_req_zone $auth_key zone=auth:10m rate=10r/m;
limit_req_status 429;

server {
  # The API's address changes with every deploy. A fixed proxy_pass host is
  # resolved once, at start, and then points at a container that is gone; with
  # the container's own DNS (resolv.conf) and a variable, it is looked up again.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;

  location /api/ {
    limit_req zone=api burst=40 nodelay;
    limit_req zone=auth burst=5 nodelay;
    # Without a URI part, proxy_pass sends the request URI as it came.
    set $api_upstream ${API_UPSTREAM};
    proxy_pass http://$api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  error_page 429 = @too_many_requests;

  location @too_many_requests {
    default_type application/json;
    return 429 '{"reason":"TOO_MANY_REQUESTS"}';
  }

  location / {
    try_files $uri /index.html;
  }
}
