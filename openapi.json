{
  "openapi": "3.1.0",
  "info": {
    "title": "Guerra naval",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "MatchConfig": {
        "type": "object",
        "required": [
          "boardSize",
          "shipLengths",
          "difficulty",
          "firstTurn",
          "extraTurnOnHit",
          "enabledWeapons"
        ],
        "properties": {
          "boardSize": {
            "type": "integer"
          },
          "shipLengths": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "EASY",
              "NORMAL",
              "HARD"
            ]
          },
          "firstTurn": {
            "type": "string",
            "enum": [
              "HUMAN",
              "BOT",
              "RANDOM"
            ]
          },
          "extraTurnOnHit": {
            "type": "boolean"
          },
          "enabledWeapons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "ammo"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "MISSILE",
                    "BOMB",
                    "BOMBER",
                    "TORPEDO",
                    "RECON_PLANE"
                  ]
                },
                "ammo": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ConfigureMatchInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "boardSize": {
            "type": "integer"
          },
          "shipLengths": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "EASY",
              "NORMAL",
              "HARD"
            ]
          },
          "firstTurn": {
            "type": "string",
            "enum": [
              "HUMAN",
              "BOT",
              "RANDOM"
            ]
          },
          "extraTurnOnHit": {
            "type": "boolean"
          },
          "enabledWeapons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "ammo"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "MISSILE",
                    "BOMB",
                    "BOMBER",
                    "TORPEDO",
                    "RECON_PLANE"
                  ]
                },
                "ammo": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ConfigRejected": {
        "type": "object",
        "required": [
          "accepted",
          "rejection"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "rejection": {
            "type": "string",
            "enum": [
              "MATCH_IN_PROGRESS",
              "BOARD_SIZE_OUT_OF_LIMITS",
              "FLEET_DOES_NOT_FIT",
              "FLEET_SIZE_OUT_OF_LIMITS",
              "ARSENAL_AMMO_OUT_OF_LIMITS",
              "ARSENAL_WEAPONS_NOT_CONFIGURABLE_WEAPONS"
            ]
          }
        }
      },
      "MatchStartRejected": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "MATCH_IN_PROGRESS"
            ]
          }
        }
      },
      "NoMatch": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "NO_MATCH"
            ]
          }
        }
      },
      "BoardView": {
        "type": "object",
        "required": [
          "size",
          "cells"
        ],
        "properties": {
          "size": {
            "type": "integer"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "EMPTY",
                  "SHIP",
                  "MISS",
                  "HIT",
                  "SUNK"
                ]
              }
            }
          }
        }
      },
      "MatchView": {
        "type": "object",
        "required": [
          "phase",
          "ownBoard",
          "rivalBoard",
          "fleet",
          "arsenal"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "PLACEMENT",
              "IN_PROGRESS",
              "FINISHED"
            ]
          },
          "ownBoard": {
            "$ref": "#/components/schemas/BoardView"
          },
          "rivalBoard": {
            "$ref": "#/components/schemas/BoardView"
          },
          "fleet": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "length",
                "placed",
                "sunk"
              ],
              "properties": {
                "length": {
                  "type": "integer"
                },
                "placed": {
                  "type": "boolean"
                },
                "sunk": {
                  "type": "boolean"
                }
              }
            }
          },
          "arsenal": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "ammo"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "MISSILE",
                    "BOMB",
                    "BOMBER",
                    "TORPEDO",
                    "RECON_PLANE"
                  ]
                },
                "ammo": {
                  "type": [
                    "null",
                    "integer"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/config": {
      "get": {
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "configureMatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigureMatchInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchConfig"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigRejected"
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigRejected"
                }
              }
            }
          }
        }
      }
    },
    "/api/match": {
      "post": {
        "operationId": "startMatch",
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchView"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchStartRejected"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getMatch",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchView"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoMatch"
                }
              }
            }
          }
        }
      }
    }
  }
}
